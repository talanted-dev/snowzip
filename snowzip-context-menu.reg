Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\.snzip]
@="SnowZIP.Archive"

[HKEY_CURRENT_USER\Software\Classes\SnowZIP.Archive\DefaultIcon]
@="C:\\your\\path\\to\\snowzip.exe,0"

[HKEY_CURRENT_USER\Software\Classes\SnowZIP.Archive\shell\open]
@="Открыть в SnowZIP"

[HKEY_CURRENT_USER\Software\Classes\SnowZIP.Archive\shell\open\command]
@="\"C:\\your\\path\\to\\snowzip.exe\" \"%1\""
